---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Kategorien from "../components/home/Kategorien.astro";
import WasUnsBewegt from "../components/home/WasUnsBewegt.astro";
import Vertrauen from "../components/home/Vertrauen.astro";
import Team from "../components/home/Team.astro";
import Qualifikationen from "../components/home/Qualifikationen.astro";
---

<BaseLayout
  title="Startseite"
  description="Gesundheit, Bewegung und gemeinsame Erlebnisse für Kinder, Familien und Unternehmen."
  audience="familie"
  headerTheme="onDark"
>
  <Hero />
  <Kategorien />
  <!-- Eine durchgehende Textur für beide Sektionen, damit an der Grenze keine Kante entsteht. -->
  <div class="relative">
    <img
      src="/images/home/texture-was-uns-bewegt-vertrauen.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover object-top"
    />
    <WasUnsBewegt />
    <Vertrauen />
  </div>
  <Team />
  <Qualifikationen />
</BaseLayout>
