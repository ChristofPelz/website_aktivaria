---
// Fußzeile nach dem Figma-Rahmen "08 Footer": zwei multiplizierte Verläufe
// (art/footer-1, art/footer-8) auf weißem Grund, darüber der Inhalt in Weiß.
const memberships = [
  "DVGS – Deutscher Verband für Gesundheitssport und Sporttherapie e.V.",
  "DRK Wasserwacht – Wasserwacht Sachsen-Anhalt",
  "BvAP – Bundesverband für Aquapädagogik e.V.",
  "IG Innenstadt – Stadtmarketing für Magdeburg",
  "MarketingClub Magdeburg – Die Marketing Community Sachsen-Anhalt",
  "Creditreform – Wir sind Mitglied",
];

const columns = [
  [
    { label: "Kontakt", href: "/kontakt" },
    { label: "FAQ", href: "/faq" },
    { label: "Kalender", href: "/kalender" },
  ],
  [
    { label: "Das Team", href: "/team" },
    { label: "Karriere", href: "/karriere" },
    { label: "Newsletter abonnieren", href: "/newsletter" },
  ],
  [
    { label: "Barrierefreiheit", href: "/barrierefreiheit" },
    { label: "Impressum", href: "/impressum" },
    { label: "Datenschutz", href: "/datenschutz" },
  ],
];

// Breite, Höhe und Abstand zum Vorgänger wie in Figma (icon/footer-3 bis -7).
const social = [
  { label: "Facebook", href: "https://facebook.com", icon: "social-facebook.svg", w: 26.11, h: 48.04, gap: 0 },
  { label: "Instagram", href: "https://instagram.com", icon: "social-instagram.svg", w: 38.97, h: 38.97, gap: 27 },
  { label: "LinkedIn", href: "https://linkedin.com", icon: "social-linkedin.svg", w: 45.26, h: 54.42, gap: 28 },
  { label: "YouTube", href: "https://youtube.com", icon: "social-youtube.svg", w: 57.12, h: 57.12, gap: 18 },
  { label: "WhatsApp", href: "https://wa.me/", icon: "social-whatsapp.svg", w: 63.49, h: 63.49, gap: 8.5 },
];
---

<footer class="relative isolate overflow-hidden bg-white text-white">
  <div aria-hidden="true" class="gradient-footer-1 absolute inset-x-0 top-[25px] bottom-0 mix-blend-multiply"></div>
  <div
    aria-hidden="true"
    class="gradient-footer-2 absolute inset-0 mix-blend-multiply [clip-path:polygon(0_19.6px,100%_0,100%_100%,0_100%)]"
  >
  </div>

  <div class="relative mx-auto max-w-[1658px] px-5 pt-16 pb-12 md:px-10 xl:pt-[115px] xl:pb-[129px]">
    <h2 class="text-lead font-bold md:text-h3">Mitgliedschaften</h2>
    <ul class="mt-4 text-body font-bold md:text-body-lg xl:mt-[26px]">
      {memberships.map((m) => <li>{m}</li>)}
    </ul>

    <a href="/" class="mx-auto mt-10 block w-[180px] xl:mt-2 xl:w-[323px]">
      <img
        src="/images/logo-mark-white.svg"
        alt="aktiVaria, Entdecke den Sport"
        width="323"
        height="133"
        class="h-auto w-full"
      />
    </a>

    <nav aria-label="Fußzeile" class="mt-8 md:mx-auto md:w-fit xl:mt-[30px]">
      <div class="flex flex-col gap-2 md:grid md:grid-cols-3 md:gap-x-16 xl:grid-cols-[338px_410px_auto] xl:gap-x-0">
        {
          columns.map((col) => (
            <ul class="flex flex-col gap-2">
              {col.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="relative inline-block px-1 py-3 text-body-lg whitespace-nowrap text-white after:absolute after:top-[42px] after:left-1 after:h-px after:w-[60px] after:bg-white after:opacity-0 hover:after:opacity-100 focus-visible:shadow-[var(--shadow-focus)] focus-visible:outline-none"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </nav>

    <ul class="mt-10 flex items-center justify-center xl:mt-[44px]">
      {
        social.map((s) => (
          <li style={`margin-left: ${s.gap}px`}>
            <a
              href={s.href}
              aria-label={s.label}
              class="block transition-opacity hover:opacity-80 focus-visible:shadow-[var(--shadow-focus)] focus-visible:outline-none"
            >
              <img src={`/images/icons/${s.icon}`} alt="" width={s.w} height={s.h} style={`width:${s.w}px;height:${s.h}px`} />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-center text-body font-bold xl:mt-[30px]">© 2026 aktiVaria GmbH</p>
  </div>
</footer>
