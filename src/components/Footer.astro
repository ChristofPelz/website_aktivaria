---
const memberships = [
  "DVGS – Deutscher Verband für Gesundheitssport und Sporttherapie e.V.",
  "DRK Wasserwacht – Wasserwacht Sachsen-Anhalt",
  "BvAP – Bundesverband für Aquapädagogik e.V.",
  "IG Innenstadt – Stadtmarketing für Magdeburg",
  "MarketingClub Magdeburg – Die Marketing Community Sachsen-Anhalt",
  "Creditreform – Wir sind Mitglied",
];

const columns = [
  [
    { label: "Kontakt", href: "/kontakt" },
    { label: "FAQ", href: "/faq" },
    { label: "Kalender", href: "/kalender" },
  ],
  [
    { label: "Das Team", href: "/team" },
    { label: "Karriere", href: "/karriere" },
    { label: "Newsletter abonnieren", href: "/newsletter" },
  ],
  [
    { label: "Barrierefreiheit", href: "/barrierefreiheit" },
    { label: "Impressum", href: "/impressum" },
    { label: "Datenschutz", href: "/datenschutz" },
  ],
];

const social = [
  { label: "Facebook", href: "https://facebook.com", icon: "/images/icons/social-facebook.svg" },
  { label: "Instagram", href: "https://instagram.com", icon: "/images/icons/social-instagram.svg" },
  { label: "LinkedIn", href: "https://linkedin.com", icon: "/images/icons/social-linkedin.svg" },
  { label: "YouTube", href: "https://youtube.com", icon: "/images/icons/social-youtube.svg" },
  { label: "WhatsApp", href: "https://wa.me/", icon: "/images/icons/social-whatsapp.svg" },
];
---

<footer
  class="bg-brand-blue bg-blend-multiply text-white"
  style="background-image: linear-gradient(100deg, #1b3f86 0%, rgba(26,70,157,0.5) 40%, rgba(27,67,146,0.5) 57%, #1b3f86 100%);"
>
  <div class="border-b border-white/10">
    <div class="mx-auto max-w-7xl px-6 py-6">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-white/60">
        Mitgliedschaften
      </p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-white/80">
        {memberships.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-14 text-center">
    <a href="/" class="inline-block">
      <img src="/images/logo-mark-white.svg" alt="aktiVaria — Entdecke den Sport" class="h-16 w-auto" />
    </a>

    <div class="mx-auto mt-10 grid max-w-2xl gap-8 sm:grid-cols-3">
      {
        columns.map((col) => (
          <ul class="space-y-3 text-base">
            {col.map((link) => (
              <li>
                <a href={link.href} class="text-white/90 hover:text-white">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center gap-5">
      {
        social.map((s) => (
          <a href={s.href} class="opacity-70 transition hover:opacity-100" aria-label={s.label}>
            <img src={s.icon} alt="" class="h-6 w-6" />
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-sm font-bold text-white/90">© 2026 aktiVaria GmbH</p>
  </div>
</footer>
