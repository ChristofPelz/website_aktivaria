---
// Design System "Button", Variante Weiss: Pill 66 px hoch, text/body-lg-bold.
// Hover: 2 px Rahmen blue-900 und tieferer Schatten, Focus: 3 px Ring blue-900.
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-full bg-white px-8 py-5 text-center text-body-lg font-bold text-brand-blue-700 shadow-card transition-shadow duration-150",
    "hover:shadow-[inset_0_0_0_2px_var(--color-brand-blue-900),var(--shadow-card-hover)]",
    "focus-visible:shadow-[var(--shadow-card),var(--shadow-focus)] focus-visible:outline-none",
    className,
  ]}
>
  <slot />
</a>
