---
// Qualifikationskarte nach Vorlage: Logo (max. 48 x 48) links neben Titel und
// Untertitel, darunter der Beschreibungstext über die volle Kartenbreite.
interface Props {
  title: string;
  tag: string;
  description: string;
  /** w/h: Seitenverhältnis des Logos; backdrop: graue Fläche hinter dem IHK-Logo (icon/qualifikationen-18) */
  logo: { src: string; w: number; h: number; backdrop?: { w: number; h: number } };
}

const { title, tag, description, logo } = Astro.props;
---

<article class="self-start rounded-md border border-neutral-200 bg-white p-8 shadow-[0_3px_6px_rgb(0_0_0/0.06)]">
  <div class="flex min-h-12 items-start gap-4">
    <div class="flex size-12 shrink-0 items-center justify-center">
      {
        logo.backdrop ? (
          <div class="w-12 bg-neutral-200" style={`aspect-ratio:${logo.backdrop.w}/${logo.backdrop.h}`}>
            <img
              src={logo.src}
              alt=""
              loading="lazy"
              width={logo.w}
              height={logo.h}
              class="h-auto"
              style={`width:${(logo.w / logo.backdrop.w) * 100}%`}
            />
          </div>
        ) : (
          <img
            src={logo.src}
            alt=""
            loading="lazy"
            width={logo.w}
            height={logo.h}
            class="h-auto max-h-12 w-auto max-w-12"
          />
        )
      }
    </div>
    <div class="min-w-0 hyphens-auto">
      <h4 class="text-body-lg font-bold">{title}</h4>
      <p class="mt-0.5 text-caption font-medium">{tag}</p>
    </div>
  </div>
  <p class="mt-8 text-caption">{description}</p>
</article>
