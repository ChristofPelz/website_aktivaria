---
// Karte aus "07 Qualifikationen": 499 x 286, Radius 60, Logo mittig in der
// linken Spalte (184 px), Text vertikal zentriert. Breiten der Textblöcke wie in Figma.
interface Props {
  title: string;
  tag: string;
  description: string;
  /** backdrop: graue Fläche hinter dem Logo (icon/qualifikationen-18 beim IHK-Logo) */
  logo: { src: string; w: number; h: number; backdrop?: { w: number; h: number } };
  textWidth?: number;
}

const { title, tag, description, logo, textWidth = 267 } = Astro.props;
---

<article
  class="flex min-h-[286px] w-full max-w-[499px] flex-col items-center gap-6 rounded-2xl bg-white px-6 py-8 shadow-card md:grid md:grid-cols-[184px_1fr] md:gap-0 md:py-6 md:pr-4 md:pl-0"
>
  <div
    class="justify-self-center bg-neutral-200"
    style={logo.backdrop
      ? `width:${logo.backdrop.w}px;height:${logo.backdrop.h}px`
      : "background:none"}
  >
    <img
      src={logo.src}
      alt=""
      loading="lazy"
      width={logo.w}
      height={logo.h}
      class="max-w-none"
      style={`width:${logo.w}px;height:${logo.h}px`}
    />
  </div>
  <div class="w-full" style={`max-width:${textWidth}px`}>
    <h4 class="max-w-[267px] text-body-lg font-bold">{title}</h4>
    <p class="mt-2 text-caption font-medium">{tag}</p>
    <p class="text-caption">{description}</p>
  </div>
</article>
