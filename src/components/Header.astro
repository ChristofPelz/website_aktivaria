---
interface Props {
  audience?: "familie" | "unternehmen";
}

const { audience = "familie" } = Astro.props;

const familieNav = [
  { label: "Bewegung", href: "/bewegungsschule" },
  { label: "Schwimmen", href: "/schwimmschule" },
  { label: "Feriencamp", href: "/feriencamp" },
  { label: "Kinderbetreuung", href: "/kinderbetreuung" },
  { label: "Kontakt", href: "/kontakt" },
];

const unternehmenNav = [
  { label: "Screenings", href: "/unternehmen/screening" },
  { label: "Kurse", href: "/unternehmen/kurse" },
  { label: "Ernährung", href: "/ernaehrung" },
  { label: "Leistungen", href: "/unternehmen/leistungen" },
  { label: "Über uns", href: "/unternehmen/team" },
];

const nav = audience === "unternehmen" ? unternehmenNav : familieNav;
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3">
    <a href="/" class="shrink-0">
      <img src="/images/logo-mark.svg" alt="aktiVaria" class="h-9 w-auto" />
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium md:flex">
      {
        nav.map((item) => (
          <a href={item.href} class="text-brand-blue hover:text-brand-blue/70">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3 rounded-full bg-white p-1 text-sm font-medium shadow-[0_3px_6px_rgba(0,0,0,0.16)]">
      {
        audience === "unternehmen" ? (
          <>
            <a
              href="/"
              class="rounded-full bg-category-bgf px-4 py-2 font-medium text-white transition hover:opacity-90"
            >
              Familien &amp; Kinder
            </a>
            <span class="pr-3 text-brand-blue">Geschäftskunden</span>
          </>
        ) : (
          <>
            <a
              href="/unternehmen"
              class="rounded-full bg-category-bgf px-4 py-2 font-medium text-white transition hover:opacity-90"
            >
              Geschäftskunden
            </a>
            <span class="pr-3 text-brand-blue">Familien &amp; Kinder</span>
          </>
        )
      }
    </div>
  </div>
</header>
