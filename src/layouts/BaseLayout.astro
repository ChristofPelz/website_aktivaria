---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  audience?: "familie" | "unternehmen";
  headerTheme?: "onDark" | "onLight";
}

const { title, description, audience = "familie", headerTheme = "onLight" } = Astro.props;
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · aktiVaria</title>
  </head>
  <body class="text-brand-blue-700">
    <Header audience={audience} theme={headerTheme} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
